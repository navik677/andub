<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <solid android:color="#242a3a" />
            <stroke android:width="2dp" android:color="@color/card_border_focus" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <solid android:color="#202533" />
            <stroke android:width="1.5dp" android:color="@color/card_border_focus" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <solid android:color="#141722" />
            <stroke android:width="1dp" android:color="#262c3d" />
        </shape>
    </item>
</selector>
