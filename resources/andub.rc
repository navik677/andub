      VALUE "InternalName", "andub"
      VALUE "LegalCopyright", "navik677"
      VALUE "OriginalFilename", "andub.exe"
      VALUE "ProductName", "Andub"
      VALUE "ProductVersion", "2.0.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1252
  END
END
